</style></head><body><main class=\"shell\"><header class=\"top\"><div class=\"brand\"><span class=\"mark\">✓</span>WadaPakka</div><div class=\"topnote\"><strong>●</strong> Reliability layer lab · Synthetic borrower only</div></header><section class=\"hero\"><h1>A payment promise deserves a second listen.</h1><p>Give both pipelines the same borrower turn. Watch one write its first guess while the other reads every critical detail back before recording a promise.</p></section><section class=\"toolbar\" aria-label=\"Demo controls\"><button id=\"new\" class=\"primary\">Start comparison</button><button id=\"record\" class=\"record\" disabled><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"9\" y=\"2\" width=\"6\" height=\"13\" rx=\"3\"/><path d=\"M5 10a7 7 0 0 0 14 0M12 17v5m-4 0h8\"/></svg><span>Record turn</span></button><input id=\"typed\" class=\"input\" placeholder=\"Or type: main parso dhai hazaar UPI se de dunga\" aria-label=\"Borrower transcript\"><button id=\"send\" class=\"ghost\" disabled>Send turn</button><span id=\"status\" class=\"status\" role=\"status\">Start a comparison to begin.</span></section><section class=\"compare\"><article class=\"pipeline\"><div class=\"pipehead\"><div><h2>Naive pipeline</h2><p>First complete parse writes immediately</p></div><span class=\"tag\">UNVERIFIED</span></div><div class=\"pipebody\"><p class=\"sectionlabel\">Borrower transcript</p><p class=\"transcript empty\" id=\"naiveTranscript\">Waiting for a turn…</p><p class=\"sectionlabel\">Extracted slots</p><div class=\"slotgrid\" id=\"naiveSlots\"></div><div class=\"decision\"><p class=\"sectionlabel\">Decision</p><div class=\"decisionline\" id=\"naiveDecision\">No decision yet</div><p id=\"naiveDetail\">A complete amount, date and mode will go straight to the ledger.</p></div></div></article><article class=\"pipeline layer\"><div class=\"pipehead\"><div><h2>Reliability layer</h2><p>Normalize · read back · confirm · commit</p></div><span class=\"tag\">CONFIRM BY DEFAULT</span></div><div class=\"pipebody\"><p class=\"sectionlabel\">Borrower transcript</p><p class=\"transcript empty\" id=\"layerTranscript\">Waiting for a turn…</p><p class=\"sectionlabel\">Critical slots</p><div class=\"slotgrid\" id=\"layerSlots\"></div><div class=\"decision\"><p class=\"sectionlabel\">Decision</p><div class=\"decisionline\" id=\"layerDecision\">No decision yet</div><p id=\"layerDetail\">Each critical slot stays pending until the borrower confirms the spoken read back.</p><div class=\"actionrow\"><button id=\"yes\" class=\"small\" disabled>Confirm: haan</button><button id=\"no\" class=\"small\" disabled>Correct: nahi</button><button id=\"play\" class=\"small\" disabled>Play agent voice</button></div></div><p class=\"sectionlabel\" style=\"margin-top:20px\">Agent read back</p><div class=\"agentline\" id=\"agentLine\">Agent prompt appears here.</div><div class=\"handoff\" id=\"handoff\"></div></div></article></section><section class=\"below\"><div class=\"panel\"><div class=\"panelhead\"><h2>Turn observability</h2><span class=\"muted\">Transcript → slots → decision → latency</span></div><ol class=\"timeline\" id=\"timeline\"><li><time>—</time><div><strong>No turns yet</strong><span>Record or type a borrower line.</span></div></li></ol></div><div class=\"panel\"><div class=\"panelhead\"><h2>Promise ledger</h2><span class=\"muted\" id=\"ledgerCount\">0 writes</span></div><div class=\"tablewrap\"><table><thead><tr><th>Pipeline</th><th>Amount</th><th>Date</th><th>Mode</th><th>Commit</th></tr></thead><tbody id=\"ledgerRows\"><tr><td colspan=\"5\" class=\"muted\">No promises recorded.</td></tr></tbody></table></div><div id=\"handoffBrief\" class=\"handoff\"></div></div></section><section class=\"eval\"><div class=\"evalbar\"><h2>Fixture evaluation</h2><button id=\"eval\" class=\"small\">Run text eval</button><span id=\"evalResult\" class=\"evalresult\">Eight synthetic, different transcripts. Audio results are reported separately in the README.</span></div></section><p class=\"foot\">Prisma v3.0 STT · Timbre v2.5 voice Poorvi · No model confidence score. Demo data and account are fictional. Microphone needs browser permission, an API key and ffmpeg on the server.</p></main>
<script>
const "'$=id=>document.getElementById(id);let ids={},results={},recorder,parts=[],recording=false,prompt='"'',playing=null;const slotNames={amount_inr:'Amount',pay_date:'Date',mode:'Payment'};
function setStatus(t){"'$('"'status').textContent=t}async function api(url,options){const r=await fetch(url,options);const d=await r.json();if("'!r.ok)throw Error(typeof d.detail==='"'string'?d.detail:JSON.stringify(d.detail||d));return d}
async function speak(t){if("'!t)return;try{if(playing)playing.pause();const r=await fetch('"'/api/tts?text='+encodeURIComponent(t));if("'!r.ok)throw Error('"'Timbre unavailable');const blob=await r.blob();const u=URL.createObjectURL(blob);playing=new Audio(u);playing.onended=()=>URL.revokeObjectURL(u);await playing.play()}catch(e){setStatus('Voice unavailable; read back shown as text.')}}
function renderSlots(kind,s){const wrap="'$(kind+'"'Slots');wrap.replaceChildren();for(const [key,label] of Object.entries(slotNames)){const v=s.slots?.[key];const status=s.state==='WRITTEN'&&kind==='layer'?'confirmed':s.state==='CONFIRMING'&&kind==='layer'?'read back':v?'captured':'pending';const box=document.createElement('div');box.className='slot';const value=key==='amount_inr'&&v?'₹'+Number(v).toLocaleString('en-IN'):v||'—';box.innerHTML='<div class=\"slotname\">'+label+'</div><div class=\"slotvalue\"></div><div class=\"slotstate '+(status==='confirmed'?'confirmed':status==='pending'?'pending':'')+'\">'+status.toUpperCase()+'</div>';box.querySelector('.slotvalue').textContent=value;wrap.append(box)}}
function render(kind,d){results[kind]=d;const s=d.session;"'$(kind+'"'Transcript').textContent=d.transcript||'Waiting for a turn…';"'$(kind+'"'Transcript').classList.toggle('empty',"'!d.transcript);renderSlots(kind,s);const decision=d.event?.decision||'"'No decision yet';const labels={naive_write:'Wrote without confirmation',naive_incomplete:'Waiting for missing slots',readback:'Read back required',need_more_slots:'Clarification required',confirmed_write:'Confirmed promise written',duplicate_confirmation:'Duplicate prevented',correction_requested:'Correction requested',handoff:'Human handoff',refused:'Borrower refused'};"'$(kind+'"'Decision').textContent=labels[decision]||decision.replaceAll('_',' ');"'$(kind+'"'Detail').textContent=kind==='layer'?(d.verdict?.slots?.date_note==='kal_ambiguous'?'“Kal” can mean yesterday or tomorrow. Ask for an exact date.':decision==='readback'?'No write until the borrower confirms all three details.':decision==='handoff'?'Automation stopped; send the brief to a human.':decision==='confirmed_write'?'One idempotent ledger entry was recorded.':'The layer is collecting a safe, complete promise.'):(decision==='naive_write'?'The first parsed triple was committed with no read back.':'The naive path cannot commit an incomplete triple.');if(kind==='layer'){prompt=d.prompt||'';"'$('"'agentLine').textContent=prompt||'Agent prompt appears here.';"'$('"'yes').disabled=s.state"'!=='"'CONFIRMING';"'$('"'no').disabled=s.state"'!=='"'CONFIRMING';"'$('"'play').disabled="'!prompt;let brief=d.handoff_brief;$('"'handoff').classList.toggle('show',"'!!brief);$('"'handoffBrief').classList.toggle('show',"'!!brief);$('"'handoff').textContent=brief?'Human brief: '+brief:'';"'$('"'handoffBrief').textContent=brief||'';"'$('"'send').disabled=['WRITTEN','HANDOFF','REFUSED'].includes(s.state);"'$('"'record').disabled="'$('"'send').disabled}refreshLedger();renderTimeline()}
function renderTimeline(){const el="'$('"'timeline');el.replaceChildren();let events=[...(results.naive?.session?.turns||[]).map(x=>({...x,pipe:'Naive'})),...(results.layer?.session?.turns||[]).map(x=>({...x,pipe:'Layer'}))];if("'!events.length){el.innerHTML='"'<li><time>—</time><div><strong>No turns yet</strong><span>Record or type a borrower line.</span></div></li>';return}events.forEach((e,i)=>{const li=document.createElement('li');const t=document.createElement('time');t.textContent='Turn '+(i+1);const body=document.createElement('div');const title=document.createElement('strong');title.textContent=e.pipe+' · '+e.decision.replaceAll('_',' ');const detail=document.createElement('span');const s=e.verdict?.slots||e.slots||{};detail.textContent='“'+e.transcript+'” · '+[s.amount_inr?'₹'+s.amount_inr:null,s.pay_date,s.mode].filter(Boolean).join(' / ')+' · '+e.latency_ms+' ms';body.append(title,detail);li.append(t,body);el.append(li)})}
async function refreshLedger(){try{const data=await api('/api/ledger');const rows=data.rows.filter(r=>Object.values(ids).includes(r.session_id));"'$('"'ledgerCount').textContent=rows.length+' write'+(rows.length===1?'':'s');const body="'$('"'ledgerRows');body.replaceChildren();if("'!rows.length){body.innerHTML='"'<tr><td colspan=\"5\" class=\"muted\">No promises recorded.</td></tr>';return}for(const r of rows){const tr=document.createElement('tr');[r.session_id===ids.naive?'Naive':'Layer','₹'+r.amount_inr.toLocaleString('en-IN'),r.pay_date,r.mode,r.commit_key.slice(0,8)].forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.append(td)});body.append(tr)}}catch(e){setStatus(e.message)}}
"'$('"'new').onclick=async()=>{try{setStatus('Starting paired sessions…');const [n,l]=await Promise.all([api('/api/session',{method:'POST'}),api('/api/session',{method:'POST'})]);ids={naive:n.session.id,layer:l.session.id};results={};render('naive',n);render('layer',l);"'$('"'send').disabled=false;"'$('"'record').disabled=false;setStatus('Both pipelines ready. Send one borrower turn.');prompt=l.prompt}catch(e){setStatus(e.message)}};
async function submitText(t){if("'!t.trim()||!ids.layer)return;try{setStatus('"'Processing both pipelines…');const jobs=['naive','layer'].filter(k=>"'!['"'WRITTEN','HANDOFF','REFUSED'].includes(results[k]?.session?.state)).map(async k=>{const d=await api('/api/turn-text',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({session_id:ids[k],transcript:t,mode:k})});render(k,d)});await Promise.all(jobs);setStatus('Turn processed.');if(prompt)await speak(prompt)}catch(e){setStatus('Turn failed: '+e.message)}}"'$('"'send').onclick=()=>{const t="'$('"'typed').value;"'$('"'typed').value='';submitText(t)};"'$('"'typed').onkeydown=e=>{if(e.key==='Enter')"'$('"'send').click()};
async function submitAudio(blob){try{setStatus('Transcribing the same clip in both pipelines…');const jobs=['naive','layer'].filter(k=>"'!['"'WRITTEN','HANDOFF','REFUSED'].includes(results[k]?.session?.state)).map(async k=>{const fd=new FormData();fd.append('session_id',ids[k]);fd.append('mode',k);fd.append('audio',blob,'turn.webm');const d=await api('/api/turn',{method:'POST',body:fd});render(k,d)});await Promise.all(jobs);setStatus('Audio turn processed.');if(prompt)await speak(prompt)}catch(e){setStatus('Audio failed: '+e.message)}}"'$('"'record').onclick=async()=>{if("'!recording){try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});parts=[];recorder=new MediaRecorder(stream);recorder.ondataavailable=e=>{if(e.data.size)parts.push(e.data)};recorder.onstop=()=>{stream.getTracks().forEach(x=>x.stop());submitAudio(new Blob(parts,{type:recorder.mimeType}))};recorder.start();recording=true;$('"'record').classList.add('active');"'$('"'record').querySelector('span').textContent='Stop recording';setStatus('Recording… click again to stop.')}catch(e){setStatus('Microphone unavailable: '+e.message)}}else{recorder.stop();recording=false;"'$('"'record').classList.remove('active');"'$('"'record').querySelector('span').textContent='Record turn'}};
async function confirm(accepted){try{const d=await api('/api/confirm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({session_id:ids.layer,accepted})});render('layer',d);setStatus(accepted?'Promise confirmed.':'Correction requested.');if(d.prompt)await speak(d.prompt)}catch(e){setStatus(e.message)}}"'$('"'yes').onclick=()=>confirm(true);"'$('"'no').onclick=()=>confirm(false);"'$('"'play').onclick=()=>speak(prompt);"'$('"'eval').onclick=async()=>{try{const d=await api('/api/eval');"'$('"'evalResult').textContent="'`${d.n} paired text fixtures: naive ${d.naive_correct}/${d.n} (${Math.round(d.naive_slot_accuracy*100)}%); layer ${d.layer_correct}/${d.n} (${Math.round(d.layer_slot_accuracy*100)}%). Different supplied transcripts; confirmation is simulated.`}catch(e){setStatus(e.message)}};renderSlots('"'naive',{slots:{}});renderSlots('layer',{slots:{}});
</script></body></html>
