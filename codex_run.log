"""Indic / Hinglish number and date normalisation.

This is application logic, not a Gnani API. Prisma v2.5 ITN (format=transcribe)
covers some spoken numbers and dates; Prisma v3.0 writes numbers itself when
format=transcribe. Relative words such as parso or agle somvaar still need
this layer, and dual-pass comparison uses both spoken-form and written-form.
"""

from __future__ import annotations

import re
from datetime import date, timedelta

ONES = {
    "zero": 0, "sunya": 0, "shunya": 0, "शून्य": 0,
    "ek": 1, "एक": 1, "one": 1,
    "do": 2, "दो": 2, "two": 2,
    "teen": 3, "tin": 3, "तीन": 3, "three": 3,
    "char": 4, "chaar": 4, "चार": 4, "four": 4,
    "paanch": 5, "panch": 5, "पांच": 5, "पाँच": 5, "five": 5,
    "chhe": 6, "che": 6, "छह": 6, "six": 6,
    "saat": 7, "sat": 7, "सात": 7, "seven": 7,
    "aath": 8, "ath": 8, "आठ": 8, "eight": 8,
    "nau": 9, "नो": 9, "नौ": 9, "nine": 9,
    "das": 10, "दस": 10, "ten": 10,
    "gyarah": 11, "ग्यारह": 11, "eleven": 11,
    "barah": 12, "बारह": 12, "twelve": 12,
    "terah": 13, "तेरह": 13, "thirteen": 13,
    "chaudah": 14, "चौदह": 14, "fourteen": 14,
    "pandrah": 15, "पंद्रह": 15, "fifteen": 15,
    "solah": 16, "सोलह": 16, "sixteen": 16,
    "satrah": 17, "सत्रह": 17, "seventeen": 17,
    "atharah": 18, "अठारह": 18, "eighteen": 18,
    "unnees": 19, "उन्नीस": 19, "nineteen": 19,
    "bees": 20, "बीस": 20, "twenty": 20,
    "pachees": 25, "pachchees": 25, "pachis": 25, "पच्चीस": 25,
    "tees": 30, "तीस": 30, "thirty": 30,
    "chalees": 40, "चालीस": 40, "forty": 40,
    "pachaas": 50, "पचास": 50, "fifty": 50,
}

FRACTIONS = {
    "sawa": 1.25, "sava": 1.25, "सवा": 1.25,
    "dedh": 1.5, "डेढ़": 1.5, "डेढ": 1.5,
    "dhai": 2.5, "dhayi": 2.5, "adhai": 2.5, "ढाई": 2.5,
}

SCALES = {
    "sau": 100, "so": 100, "सौ": 100, "hundred": 100,
    "hazaar": 1000, "hazar": 1000, "hazar": 1000, "हजार": 1000,
    "thousand": 1000,
    "lakh": 100000, "lac": 100000, "लाख": 100000,
    "crore": 10000000, "करोड़": 10000000, "करोड": 10000000,
}

WEEKDAYS = {
    "somvaar": 0, "somvar": 0, "monday": 0, "सोमवार": 0,
    "mangalvaar": 1, "tuesday": 1, "मंगलवार": 1,
    "budhvaar": 2, "wednesday": 2, "बुधवार": 2,
    "guruvaar": 3, "thursday": 3, "गुरुवार": 3,
    "shukravaar": 4, "friday": 4, "शुक्रवार": 4,
    "shanivaar": 5, "saturday": 5, "शनिवार": 5,
    "ravivaar": 6, "sunday": 6, "रविवार": 6,
}


def _fold(text: str) -> str:
    text = text.lower().replace("hazār", "hazaar").replace("हज़ार", "हजार")
    text = re.sub(r"[,₹]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def parse_amount_inr(text: str) -> tuple[float | None, str]:
    """Return (amount, note). None if we cannot parse a single amount."""
    raw = _fold(text)
    # Digits already present (ITN or typed).
    digit = re.search(r"(\d{1,3}(?:,\d{2,3})+|\d+)(?:\.(\d+))?", raw)
    spoken_scale = any(k in raw for k in FRACTIONS) or any(
        k in raw for k in ("hazaar", "hazar", "हजार", "lakh", "lac", "लाख", "crore", "sau", "सौ")
    )

    total = 0.0
    matched = False
    for name, value in FRACTIONS.items():
        if re.search(rf"\b{name}\b", raw):
            scale = 1
            for sname, sval in SCALES.items():
                if re.search(rf"\b{sname}\b", raw):
                    scale = max(scale, sval)
            total = value * scale
            matched = True
            break
    if not matched:
        tokens = re.findall(r"[a-zA-Z\u0900-\u097F]+|\d+", raw)
        acc = 0.0
        i = 0
        while i < len(tokens):
            tok = tokens[i]
            if tok.isdigit():
                acc += float(tok)
                matched = True
            elif tok in ONES:
                acc += ONES[tok]
                matched = True
            elif tok in SCALES:
                if acc == 0:
                    acc = 1
                acc *= SCALES[tok]
                total += acc
                acc = 0
                matched = True
            i += 1
        total += acc

    if not matched and not digit:
        return None, "no_amount_found"
    if digit and not spoken_scale:
        whole = digit.group(0).replace(",", "")
        try:
            return float(whole), "digit_span"
        except ValueError:
            return None, "bad_digit_span"
    if matched:
        return float(total), "spoken_form"
    return None, "unparsed"


def parse_relative_date(text: str, today: date | None = None) -> tuple[date | None, str]:
    today = today or date.today()
    raw = _fold(text)
    if re.search(r"\bparso\b|\bपरसों\b|\bपरसो\b", raw):
        return today + timedelta(days=2), "parso"
    if re.search(r"\baaj\b|\bआज\b|\btoday\b", raw):
        return today, "aaj"
    if re.search(r"\bkal\b|\bकल\b", raw):
        # Kal is ambiguous (yesterday or tomorrow). Force confirmation.
        return today + timedelta(days=1), "kal_ambiguous"
    m = re.search(r"\b(agle|agla|next|अगले|अगला)\s+([a-z\u0900-\u097F]+)", raw)
    if m:
        day = WEEKDAYS.get(m.group(2))
        if day is not None:
            delta = (day - today.weekday()) % 7
            if delta == 0:
                delta = 7
            return today + timedelta(days=delta), "next_weekday"
    # ISO or numeric date
    m = re.search(r"\b(\d{1,2})[/-](\d{1,2})(?:[/-](\d{2,4}))?\b", raw)
    if m:
        dd, mm, yy = int(m.group(1)), int(m.group(2)), m.group(3)
        year = int(yy) if yy else today.year
        if year < 100:
            year += 2000
        try:
            return date(year, mm, dd), "numeric_date"
        except ValueError:
            return None, "invalid_numeric_date"
    return None, "no_date_found"


def parse_mode(text: str) -> tuple[str | None, str]:
    raw = _fold(text)
    if re.search(r"\bupi\b|\byu.?p.?i\b|\byupi\b", raw):
        return "UPI", "upi"
    if re.search(r"\bcash\b|\bnagad\b|\bनकद\b", raw):
        return "CASH", "cash"
    if re.search(r"\bneft\b|\bimps\b|\brtgs\b|\bbank\b|\btransfer\b", raw):
        return "BANK", "bank"
    return None, "no_mode_found"
"""Extract PTP slots from a transcript using the normalizer.

An optional LLM hook can be added later; the default path is deterministic
so the demo still works without a second API key.
"""

from __future__ import annotations

from dataclasses import asdict, dataclass
from datetime import date

from normalizer import parse_amount_inr, parse_mode, parse_relative_date


CRITICAL_SLOTS = ("amount_inr", "pay_date", "mode", "name", "phone")


@dataclass
class SlotFill:
    amount_inr: float | None = None
    amount_note: str = ""
    pay_date: str | None = None
    date_note: str = ""
    mode: str | None = None
    mode_note: str = ""
    name: str | None = None
    phone: str | None = None

    def as_dict(self) -> dict:
        return asdict(self)


def extract_slots(transcript: str, today: date | None = None) -> SlotFill:
    amount, amount_note = parse_amount_inr(transcript)
    when, date_note = parse_relative_date(transcript, today=today)
    mode, mode_note = parse_mode(transcript)
    phone = None
    m = __import__("re").search(r"\b(\d{10})\b", transcript)
    if m:
        phone = m.group(1)
    return SlotFill(
        amount_inr=amount,
        amount_note=amount_note,
        pay_date=when.isoformat() if when else None,
        date_note=date_note,
        mode=mode,
        mode_note=mode_note,
        phone=phone,
    )
"""Decide whether a critical slot can be trusted.

Prisma REST and streaming responses do not include a usable ASR confidence
score. Official batch samples include a `confidence` field that is `null`.
There is no documented n-best list.

This module therefore never "reads" model confidence. It invents a
trust decision from:
  1. Can the Indic normalizer parse a single unambiguous value?
  2. Do format=transcribe and format=verbatim agree after normalisation?
  3. Is the value plausible (positive amount, date not in the past, known mode)?
  4. If still untrusted, ask for a targeted Timbre read-back.

When dual-pass is skipped (single REST call for latency), every critical
slot that we are about to write is confirmed by read-back. That is the
honest fallback.
"""

from __future__ import annotations

from datetime import date
from typing import Any

from normalizer import parse_amount_inr, parse_mode, parse_relative_date
from slots import CRITICAL_SLOTS, SlotFill, extract_slots


def _amounts_agree(a: float | None, b: float | None) -> bool:
    if a is None or b is None:
        return False
    return abs(a - b) < 0.01


def assess(
    transcribe_text: str,
    verbatim_text: str | None = None,
    today: date | None = None,
    require_confirm_always: bool = True,
) -> dict[str, Any]:
    primary = extract_slots(transcribe_text, today=today)
    secondary = extract_slots(verbatim_text, today=today) if verbatim_text else None

    decisions: dict[str, Any] = {}
    # Amount
    amount_ok = primary.amount_inr is not None and primary.amount_inr > 0
    if secondary:
        amount_ok = amount_ok and _amounts_agree(primary.amount_inr, secondary.amount_inr)
    if primary.amount_note == "kal_ambiguous":
        amount_ok = amount_ok  # unused
    decisions["amount_inr"] = {
        "value": primary.amount_inr,
        "trusted": bool(amount_ok) and not require_confirm_always,
        "needs_confirm": require_confirm_always or not amount_ok,
        "reason": _reason(amount_ok, primary.amount_note, secondary.amount_note if secondary else None),
    }
    # Date
    date_ok = primary.pay_date is not None and primary.date_note != "kal_ambiguous"
    if secondary and secondary.pay_date:
        date_ok = date_ok and primary.pay_date == secondary.pay_date
    if primary.date_note == "kal_ambiguous":
        date_ok = False
    decisions["pay_date"] = {
        "value": primary.pay_date,
        "trusted": bool(date_ok) and not require_confirm_always,
        "needs_confirm": require_confirm_always or not date_ok,
        "reason": _reason(date_ok, primary.date_note, secondary.date_note if secondary else None),
    }
    # Mode
    mode_ok = primary.mode is not None
    if secondary and secondary.mode:
        mode_ok = mode_ok and primary.mode == secondary.mode
    decisions["mode"] = {
        "value": primary.mode,
        "trusted": bool(mode_ok) and not require_confirm_always,
        "needs_confirm": require_confirm_always or not mode_ok,
        "reason": _reason(mode_ok, primary.mode_note, secondary.mode_note if secondary else None),
    }

    pending = [name for name, d in decisions.items() if d["needs_confirm"] and d["value"] is not None]
    missing = [name for name, d in decisions.items() if d["value"] is None]
    return {
        "slots": primary.as_dict(),
        "decisions": decisions,
        "pending_confirm": pending,
        "missing": missing,
        "policy": (
            "confirm_every_critical_slot"
            if require_confirm_always
            else "confirm_when_dual_pass_disagrees_or_implausible"
        ),
        "note": (
            "Prisma does not expose usable ASR confidence or n-best. "
            "Trust here is dual-pass agreement plus normalizer plausibility."
        ),
        "critical_slots": list(CRITICAL_SLOTS),
    }


def _reason(ok: bool, note: str, other: str | None) -> str:
    if other and other != note:
        return f"{note}; dual_pass_other={other}; agree={ok}"
    return note if ok else f"untrusted:{note}"


def readback_prompt(decisions: dict[str, Any]) -> str:
    parts = []
    amount = decisions.get("amount_inr", {}).get("value")
    when = decisions.get("pay_date", {}).get("value")
    mode = decisions.get("mode", {}).get("value")
    if amount is not None:
        parts.append(f"{int(amount)} rupaye")
    if when:
        parts.append(f"tareekh {when}")
    if mode:
        parts.append(f"mode {mode}")
    if not parts:
        return "Main samajh nahi paayi. Kitne rupaye, kab, aur kaise bharenge? Ek baar clearly boliye."
    joined = ", ".join(parts)
    return f"Confirm karne ke liye boliye haan. Maine note kiya: {joined}. Galat ho to sahi figures boliye."
"""PTP conversation state machine.

States:
  GREETING -> COLLECTING -> CONFIRMING -> WRITTEN
                                    -> CLARIFY -> COLLECTING
  any -> HANDOFF
  any -> REFUSED
"""

from __future__ import annotations

from enum import Enum


class State(str, Enum):
    GREETING = "GREETING"
    COLLECTING = "COLLECTING"
    CONFIRMING = "CONFIRMING"
    CLARIFY = "CLARIFY"
    WRITTEN = "WRITTEN"
    HANDOFF = "HANDOFF"
    REFUSED = "REFUSED"


TRANSITIONS = {
    State.GREETING: {State.COLLECTING, State.HANDOFF, State.REFUSED},
    State.COLLECTING: {State.CONFIRMING, State.CLARIFY, State.COLLECTING, State.WRITTEN, State.HANDOFF, State.REFUSED},
    State.CONFIRMING: {State.WRITTEN, State.CLARIFY, State.COLLECTING, State.HANDOFF, State.REFUSED},
    State.CLARIFY: {State.COLLECTING, State.CONFIRMING, State.HANDOFF, State.REFUSED},
    State.WRITTEN: set(),
    State.HANDOFF: set(),
    State.REFUSED: set(),
}


def can_move(current: State, nxt: State) -> bool:
    return nxt in TRANSITIONS[current]
"""Idempotent PTP commits. A retry cannot insert a second row."""

from __future__ import annotations

import hashlib
import json
from datetime import datetime, timezone
from typing import Any


def commit_key(session_id: str, amount_inr: float, pay_date: str, mode: str) -> str:
    canonical = json.dumps(
        {
            "session_id": session_id,
            "amount_inr": round(float(amount_inr), 2),
            "pay_date": pay_date,
            "mode": mode,
        },
        sort_keys=True,
    )
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


class Ledger:
    def __init__(self) -> None:
        self.rows: list[dict[str, Any]] = []
        self.keys: set[str] = set()

    def commit(self, session_id: str, amount_inr: float, pay_date: str, mode: str) -> dict[str, Any]:
        key = commit_key(session_id, amount_inr, pay_date, mode)
        if key in self.keys:
            existing = next(r for r in self.rows if r["commit_key"] == key)
            return {"written": False, "duplicate": True, "row": existing}
        row = {
            "commit_key": key,
            "session_id": session_id,
            "amount_inr": round(float(amount_inr), 2),
            "pay_date": pay_date,
            "mode": mode,
            "written_at": datetime.now(timezone.utc).isoformat(),
        }
        self.keys.add(key)
        self.rows.append(row)
        return {"written": True, "duplicate": False, "row": row}

