lumns:1fr 1fr;gap:16px;margin-top:20px}.pipeline{background:var(--panel);border-radius:16px;overflow:hidden;min-width:0}.pipeline.layer{background:#17251f}.pipehead{padding:22px 24px;border-bottom:1px solid var(--line);display:flex;align-items:start;justify-content:space-between;gap:10px}.pipehead h2{font:600 22px 'Space Grotesk';margin:0 0 5px}.pipehead p{margin:0;color:var(--muted);font-size:13px}.tag{border:1px solid #576275;border-radius:99px;padding:5px 9px;color:#d0d9e2;font-size:11px;white-space:nowrap}.layer .tag{border-color:#4b806c;color:var(--mint)}.pipebody{padding:24px}.sectionlabel{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:700;margin:0 0 10px}.transcript{font:500 20px/1.4 'Space Grotesk';min-height:58px;margin:0 0 24px}.empty{color:#a4b1c1}.slotgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.slot{background:#212b39;border-radius:10px;padding:12px;min-height:100px}.layer .slot{background:#20342b}.slotname{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.slotvalue{font:600 18px 'Space Grotesk';margin:8px 0 4px;overflow-wrap:anywhere}.slotstate{font-size:11px;color:var(--amber)}.slotstate.confirmed{color:var(--mint)}.slotstate.pending{color:var(--muted)}.decision{margin-top:22px;border-top:1px solid var(--line);padding-top:18px;min-height:140px}.decisionline{font:600 18px 'Space Grotesk';margin-bottom:8px}.decision p{color:var(--muted);font-size:13px;line-height:1.5;margin:0 0 12px}.actionrow{display:flex;gap:8px;flex-wrap:wrap}.agentline{background:#111a21;border-radius:10px;padding:13px 15px;color:#d8eee4;min-height:52px;font-size:13px;line-height:1.5}.below{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px}.panel{background:var(--panel);border-radius:16px;padding:22px 24px;min-width:0}.panel h2{font:600 20px 'Space Grotesk';margin:0 0 16px}.panelhead{display:flex;justify-content:space-between;align-items:start;gap:12px}.muted{color:var(-