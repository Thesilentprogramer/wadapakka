    let sessionId = null;
    let mediaRecorder = null;
    let chunks = [];
    let recording = false;

    const $ = (id) => document.getElementById(id);

    async function playPrompt(text) {
      $("prompt").textContent = text || "";
      if (!text) return;
      try {
        const res = await fetch("/api/tts?text=" + encodeURIComponent(text));
        if (!res.ok) return;
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const audio = new Audio(url);
        await audio.play();
      } catch (err) {
        console.warn("TTS playback skipped", err);
      }
    }

    function renderSession(data) {
      const session = data.session || data;
      sessionId = session.id;
      $("sessionView").textContent = JSON.stringify(session, null, 2);
      $("transcript").textContent = data.transcript || "";
      const closed = ["WRITTEN", "HANDOFF", "REFUSED"].includes(session.state);
      $("confirmYes").disabled = session.state !== "CONFIRMING";
      $("confirmNo").disabled = session.state !== "CONFIRMING";
      $("record").disabled = !sessionId || closed;
      $("sendText").disabled = !sessionId || closed;
    }

    $("newSession").onclick = async () => {
      const res = await fetch("/api/session", { method: "POST" });
      const data = await res.json();
      renderSession(data);
      $("status").textContent = "Session " + data.session.id;
      await playPrompt(data.prompt);
    };

    $("sendText").onclick = async () => {
      const transcript = $("typed").value.trim();
      if (!transcript || !sessionId) return;
      const res = await fetch("/api/turn-text", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ session_id: sessionId, transcript, mode: $("mode").value }),
      });
      const data = await res.json();
      renderSession(data);
      await playPrompt(data.prompt);
    };

    $("confirmYes").onclick = async () => {
      const res = await fetch("/api/confirm", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ session_id: sessionId, accepted: true }),
      });
      renderSession(await res.json());
    };
    $("confirmNo").onclick = async () => {
      const res = await fetch("/api/confirm", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ session_id: sessionId, accepted: false }),
      });
      renderSession(await res.json());
    };

    $("record").onclick = async () => {
      if (!recording) {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        chunks = [];
        mediaRecorder = new MediaRecorder(stream);
        mediaRecorder.ondataavailable = (e) => { if (e.data.size) chunks.push(e.data); };
        mediaRecorder.onstop = async () => {
          stream.getTracks().forEach((t) => t.stop());
          const blob = new Blob(chunks, { type: mediaRecorder.mimeType || "audio/webm" });
          const fd = new FormData();
          fd.append("session_id", sessionId);
          fd.append("mode", $("mode").value);
          fd.append("dual_pass_flag", "false");
          fd.append("audio", blob, "turn.webm");
          $("status").textContent = "Transcribing…";
          const res = await fetch("/api/turn", { method: "POST", body: fd });
          const data = await res.json();
          if (!res.ok) {
            $("status").textContent = "STT error: " + JSON.stringify(data);
            return;
          }
          $("status").textContent = "Turn ok";
          renderSession(data);
          await playPrompt(data.prompt);
        };
        mediaRecorder.start();
        recording = true;
        $("record").textContent = "Stop recording";
        $("status").textContent = "Recording…";
      } else {
        mediaRecorder.stop();
        recording = false;
        $("record").textContent = "Hold to talk — click to start/stop";
      }
    };

    $("evalBtn").onclick = async () => {
      const res = await fetch("/api/eval");
      const data = await res.json();
      $("evalView").innerHTML =
        '<span class="bad">Naive slot accuracy: ' + (data.naive_slot_accuracy * 100).toFixed(1) + "%</span>\n" +
        '<span class="ok">Layer slot accuracy: ' + (data.layer_slot_accuracy * 100).toFixed(1) + "%</span>\n\n" +
        JSON.stringify(data, null, 2);
    };
  </script>
</body>
