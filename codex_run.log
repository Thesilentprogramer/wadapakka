### app.py
"""WadaPakka reliability layer — FastAPI app.

Turn-taking over REST Prisma STT (POST /stt/v3), not full-duplex streaming.
Browser WebSocket cannot send the x-vad-* headers Prisma streaming needs,
and the official Python SDK does not expose those VAD knobs. A proxy plus
PCM frame pacing is possible later; tonight the shippable path is recorded
turns of at most 30 seconds.

Set GNANI_API_KEY before calling live STT/TTS. Text-only routes and /api/eval
run without a key so the skeleton can be exercised immediately.
"""

from __future__ import annotations

import os
import subprocess
import tempfile
import time
import uuid
from datetime import date, datetime, timezone
from pathlib import Path
from typing import Any

from fastapi import FastAPI, File, Form, HTTPException, UploadFile
from fastapi.responses import FileResponse, Response
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, Field

from gnani_stt import dual_pass, transcribe_rest
from gnani_tts import synthesize
from handoff import brief as handoff_brief
from handoff import detect_handoff
from idempotency import Ledger
from observability import TurnLog
from slots import extract_slots
from state_machine import State, can_move
from verifier import assess, readback_prompt


REST_AUDIO_SUFFIXES = {".wav", ".mp3", ".ogg", ".flac", ".aac", ".m4a"}


def _prepare_audio(raw: bytes, filename: str, content_type: str) -> tuple[bytes, str, str]:
    """REST STT docs list WAV, MP3, OGG, FLAC, AAC, M4A — not WebM.

    Browser MediaRecorder usually emits webm/opus or mp4, so convert those
    to 16 kHz mono WAV with ffmpeg before calling Prisma.
    """
    suffix = Path(filename or "turn.bin").suffix.lower()
    if suffix in REST_AUDIO_SUFFIXES:
        return raw, filename, content_type
    with tempfile.TemporaryDirectory() as tmp:
        src = Path(tmp) / f"input{suffix or '.bin'}"
        dst = Path(tmp) / "turn.wav"
        src.write_bytes(raw)
        proc = subprocess.run(
            [
                "ffmpeg", "-y", "-i", str(src),
                "-ac", "1", "-ar", "16000", "-sample_fmt", "s16",
                str(dst),
            ],
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0 or not dst.exists():
            raise HTTPException(
                400,
                {
                    "error": "audio_conversion_failed",
                    "detail": (proc.stderr or "")[-400:],
                    "note": "Prisma REST accepts WAV, MP3, OGG, FLAC, AAC, M4A. WebM is converted via ffmpeg.",
                },
            )
        return dst.read_bytes(), "turn.wav", "audio/wav"


ROOT = Path(__file__).resolve().parent
STATIC = ROOT / "static"

app = FastAPI(title="WadaPakka reliability layer", version="0.1.0")
if STATIC.exists():
    app.mount("/static", StaticFiles(directory=STATIC), name="static")

sessions: dict[str, dict[str, Any]] = {}
ledger = Ledger()
turn_log = TurnLog()


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _move(session: dict[str, Any], nxt: State) -> None:
    current = State(session["state"])
    if current != nxt and not can_move(current, nxt):
        raise HTTPException(400, f"illegal transition {current} -> {nxt}")
    session["state"] = nxt.value


@app.get("/")
def index() -> FileResponse:
    return FileResponse(STATIC / "index.html")


@app.post("/api/session")
def create_session() -> dict[str, Any]:
    sid = str(uuid.uuid4())
    sessions[sid] = {
        "id": sid,
        "state": State.GREETING.value,
        "slots": {},
        "pending": [],
        "turns": [],
        "created_at": _now(),
        "account": {
            "name": "Ravi Kumar",
            "outstanding_inr": 2500,
            "note": "Synthetic demo account. No real borrower data.",
        },
    }
    _move(sessions[sid], State.COLLECTING)
    greeting = (
        "Namaste, main WadaPakka bol rahi hoon. "
        "Aapka outstanding 2500 rupaye hai. "
        "Aap kab, kitna, aur kaise bharenge?"
    )
    return {"session": sessions[sid], "prompt": greeting}


class TextTurn(BaseModel):
    session_id: str
    transcript: str
    mode: str = Field(default="layer", pattern="^(naive|layer)$")
    verbatim: str | None = None
    dual_pass: bool = False


@app.post("/api/turn-text")
def turn_text(body: TextTurn) -> dict[str, Any]:
    return _handle_turn(
        session_id=body.session_id,
        transcript=body.transcript,
        mode=body.mode,
        verbatim=body.verbatim,
        stt_meta={"source": "text", "dual_pass": body.dual_pass},
        latency_ms=0,
    )


@app.post("/api/turn")
async def turn_audio(
    session_id: str = Form(...),
    mode: str = Form("layer"),
    dual_pass_flag: bool = Form(False),
    audio: UploadFile = File(...),
) -> dict[str, Any]:
    if mode not in {"naive", "layer"}:
        raise HTTPException(400, "mode must be naive or layer")
    raw = await audio.read()
    if not raw:
        raise HTTPException(400, "empty audio")
    filename = audio.filename or "turn.webm"
    content_type = audio.content_type or "application/octet-stream"
    raw, filename, content_type = _prepare_audio(raw, filename, content_type)
    started = time.perf_counter()
    verbatim = None
    if dual_pass_flag and mode == "layer":
        both = dual_pass(raw, filename=filename)
        primary = both["transcribe"]
        secondary = both["verbatim"]
        if not primary.get("success"):
            raise HTTPException(502, {"stt": primary})
        transcript = primary.get("transcript") or ""
        if secondary.get("success"):
            verbatim = secondary.get("transcript") or ""
        stt_meta = {"source": "rest_dual_pass", "transcribe": primary, "verbatim": secondary}
    else:
        primary = transcribe_rest(raw, filename=filename, content_type=content_type)
        if not primary.get("success"):
            raise HTTPException(502, {"stt": primary})
        transcript = primary.get("transcript") or ""
        stt_meta = {"source": "rest", "response": primary}
    latency_ms = int((time.perf_counter() - started) * 1000)
    return _handle_turn(
        session_id=session_id,
        transcript=transcript,
        mode=mode,
        verbatim=verbatim,
        stt_meta=stt_meta,
        latency_ms=latency_ms,
    )


def _handle_turn(
    session_id: str,
    transcript: str,
    mode: str,
    verbatim: str | None,
    stt_meta: dict[str, Any],
    latency_ms: int,
) -> dict[str, Any]:
    session = sessions.get(session_id)
    if not session:
        raise HTTPException(404, "unknown session")
    if session["state"] in {State.WRITTEN.value, State.HANDOFF.value, State.REFUSED.value}:
        raise HTTPException(409, f"session already {session['state']}")

    text = (transcript or "").strip()
    hand = detect_handoff(text)
    if hand["handoff"] and mode == "layer":
        _move(session, State.HANDOFF)
        note = handoff_brief(session.get("slots") or {}, text, hand["reason"])
        event = _record_turn(session, mode, text, stt_meta, latency_ms, {
            "decision": "handoff",
            "handoff": hand,
            "brief": note,
        })
        return {
            "session": session,
            "transcript": text,
            "prompt": "Theek hai, main aapko abhi ek saathi se jod rahi hoon.",
            "handoff_brief": note,
            "event": event,
        }

    lowered = text.lower()
    if any(w in lowered for w in ("nahi dena", "nahi bharunga", "won't pay", "refuse")):
        if mode == "layer":
            _move(session, State.REFUSED)
            event = _record_turn(session, mode, text, stt_meta, latency_ms, {"decision": "refused"})
            return {"session": session, "transcript": text, "prompt": "Theek hai, maine note kar liya.", "event": event}

    if mode == "naive":
        return _naive_commit(session, text, stt_meta, latency_ms)

    return _layer_turn(session, text, verbatim, stt_meta, latency_ms)


def _naive_commit(
    session: dict[str, Any],
    text: str,
    stt_meta: dict[str, Any],
    latency_ms: int,
) -> dict[str, Any]:
    """Write on first parseable guess. This is the before/after contrast."""
    fill = extract_slots(text)
    session["slots"] = fill.as_dict()
    if fill.amount_inr and fill.pay_date and fill.mode:
        result = ledger.commit(session["id"], fill.amount_inr, fill.pay_date, fill.mode)
        _move(session, State.WRITTEN)
        event = _record_turn(session, "naive", text, stt_meta, latency_ms, {
            "decision": "naive_write",
            "commit": result,
            "slots": fill.as_dict(),
        })
        return {
            "session": session,
            "transcript": text,
            "prompt": (
                f"Note kar liya: {fill.amount_inr} rupaye, {fill.pay_date}, {fill.mode}. "
                "(naive path: no read-back)"
            ),
            "commit": result,
            "event": event,
        }
    event = _record_turn(session, "naive", text, stt_meta, latency_ms, {
        "decision": "naive_incomplete",
        "slots": fill.as_dict(),
    })
    return {
        "session": session,
        "transcript": text,
        "prompt": "Amount, date aur payment mode boliye.",
        "event": event,
    }


def _layer_turn(
    session: dict[str, Any],
    text: str,
    verbatim: str | None,
    stt_meta: dict[str, Any],
    latency_ms: int,
) -> dict[str, Any]:
    # Yes / no during confirmation
    if session["state"] == State.CONFIRMING.value:
        lowered = text.lower()
        yes = any(w in lowered for w in ("haan", "han", "yes", "sahi", "theek", "ok", "okay", "हाँ", "हां"))
        no = any(w in lowered for w in ("nahi", "galat", "no", "wrong", "नहीं", "गलत"))
        if yes and not no:
            slots = session["slots"]
            result = ledger.commit(session["id"], slots["amount_inr"], slots["pay_date"], slots["mode"])
            _move(session, State.WRITTEN)
            event = _record_turn(session, "layer", text, stt_meta, latency_ms, {
                "decision": "confirmed_write",
                "commit": result,
            })
            return {
                "session": session,
                "transcript": text,
                "prompt": (
                    f"Promise likh diya: {slots['amount_inr']} rupaye, "
                    f"{slots['pay_date']}, {slots['mode']}."
                ),
                "commit": result,
                "event": event,
            }
        if no:
            _move(session, State.CLARIFY)
            _move(session, State.COLLECTING)
            event = _record_turn(session, "layer", text, stt_meta, latency_ms, {"decision": "correction_requested"})
            return {
                "session": session,
                "transcript": text,
                "prompt": "Theek hai, sahi figures ek baar phir boliye: kitne rupaye, kab, kaise?",
                "event": event,
            }

    verdict = assess(text, verbatim_text=verbatim, require_confirm_always=True)
    session["slots"] = verdict["slots"]
    session["pending"] = verdict["pending_confirm"]

    if verdict["missing"]:
        if session["state"] != State.CLARIFY.value:
            _move(session, State.CLARIFY)
        prompt = "Mujhe amount, tareekh aur payment mode chahiye. " + readback_prompt(verdict["decisions"])
        event = _record_turn(session, "layer", text, stt_meta, latency_ms, {
            "decision": "need_more_slots",
            "verdict": verdict,
        })
        return {"session": session, "transcript": text, "prompt": prompt, "verdict": verdict, "event": event}

    _move(session, State.CONFIRMING)
    prompt = readback_prompt(verdict["decisions"])
    event = _record_turn(session, "layer", text, stt_meta, latency_ms, {
        "decision": "readback",
        "verdict": verdict,
    })
    return {"session": session, "transcript": text, "prompt": prompt, "verdict": verdict, "event": event}


def _record_turn(
    session: dict[str, Any],
    mode: str,
    transcript: str,
    stt_meta: dict[str, Any],
    latency_ms: int,
    extra: dict[str, Any],
) -> dict[str, Any]:
    row = {
        "session_id": session["id"],
        "state": session["state"],
        "mode": mode,
        "transcript": transcript,
        "stt": {
            "confidence": None,
            "note": "Prisma REST/stream do not return usable confidence; batch samples show null.",
            "meta": stt_meta,
        },
        "latency_ms": latency_ms,
        **extra,
    }
    session["turns"].append(row)
    turn_log.record(**row)
    return row


class ConfirmBody(BaseModel):
    session_id: str
    accepted: bool


@app.post("/api/confirm")
def confirm(body: ConfirmBody) -> dict[str, Any]:
    # Typed shortcut for the UI buttons; same path as a spoken haan / nahi.
    said = "haan" if body.accepted else "nahi, galat hai"
    return turn_text(TextTurn(session_id=body.session_id, transcript=said, mode="layer"))


@app.get("/api/session/{session_id}")
def get_session(session_id: str) -> dict[str, Any]:
    session = sessions.get(session_id)
    if not session:
        raise HTTPException(404, "unknown session")
    return {"session": session, "log": [e for e in turn_log.events if e.get("session_id") == session_id]}


@app.get("/api/ledger")
def get_ledger() -> dict[str, Any]:
    return {"rows": ledger.rows}


@app.get("/api/eval")
def run_eval() -> dict[str, Any]:
    import json

    path = ROOT / "fixtures" / "eval_cases.json"
    cases = json.loads(path.read_text(encoding="utf-8"))
    naive_ok = 0
    layer_ok = 0
    details = []
    today = date.fromisoformat(cases["today"])
    for case in cases["cases"]:
        gold = case["gold"]
        naive_fill = extract_slots(case["naive_transcript"], today=today)
        naive_triple = (
            naive_fill.amount_inr == gold["amount_inr"]
            and naive_fill.pay_date == gold["pay_date"]
            and naive_fill.mode == gold["mode"]
        )
        # Naive writes immediately if it parsed anything resembling a triple,
        # even when the amount is wrong. Accuracy is whether that write matches gold.
        wrote_naive = bool(naive_fill.amount_inr and naive_fill.pay_date and naive_fill.mode)
        naive_correct = wrote_naive and naive_triple
        if naive_correct:
            naive_ok += 1

        verdict = assess(case["layer_transcript"], today=today, require_confirm_always=True)
        slots = verdict["slots"]
        parsed_ok = (
            slots["amount_inr"] == gold["amount_inr"]
            and slots["pay_date"] == gold["pay_date"]
            and slots["mode"] == gold["mode"]
        )
        # Layer only scores if it would ask for confirmation (never silent-write)
        # and the parsed slots match gold. The user saying "haan" is simulated.
        layer_correct = parsed_ok and bool(verdict["pending_confirm"]) and not verdict["missing"]
        if layer_correct:
            layer_ok += 1
        details.append({
            "id": case["id"],
            "note": case["note"],
            "gold": gold,
            "naive": naive_fill.as_dict(),
            "naive_correct": naive_correct,
            "layer": slots,
            "layer_correct": layer_correct,
            "would_confirm": verdict["pending_confirm"],
        })
    n = len(cases["cases"])
    return {
        "n": n,
        "naive_slot_accuracy": round(naive_ok / n, 3) if n else 0,
        "layer_slot_accuracy": round(layer_ok / n, 3) if n else 0,
        "naive_correct": naive_ok,
        "layer_correct": layer_ok,
        "details": details,
        "policy": cases["policy"],
    }


@app.get("/api/tts")
def tts(text: str) -> Response:
    audio, meta = synthesize(text)
    if not audio:
        raise HTTPException(502, meta)
    return Response(content=audio, media_type="audio/wav", headers={"X-TTS-Voice": str(meta.get("voice"))})


@app.get("/health")
def health() -> dict[str, Any]:
    return {
        "ok": True,
        "has_api_key": bool(os.getenv("GNANI_API_KEY")),
        "sessions": len(sessions),
        "ledger": len(ledger.rows),
    }
### normalizer.py
"""Indic / Hinglish number and date normalisation.

This is application logic, not a Gnani API. Prisma v2.5 ITN (format=transcribe)
covers some spoken numbers and dates; Prisma v3.0 writes numbers itself when
format=transcribe. Relative words such as parso or agle somvaar still need
this layer, and dual-pass comparison uses both spoken-form and written-form.
"""

from __future__ import annotations

import re
from datetime import date, timedelta

ONES = {
    "zero": 0, "sunya": 0, "shunya": 0, "शून्य": 0,
    "ek": 1, "एक": 1, "one": 1,
    "do": 2, "दो": 2, "two": 2,
    "teen": 3, "tin": 3, "तीन": 3, "three": 3,
    "char": 4, "chaar": 4, "चार": 4, "four": 4,
    "paanch": 5, "panch": 5, "पांच": 5, "पाँच": 5, "five": 5,
    "chhe": 6, "che": 6, "छह": 6, "six": 6,
    "saat": 7, "sat": 7, "सात": 7, "seven": 7,
    "aath": 8, "ath": 8, "आठ": 8, "eight": 8,
    "nau": 9, "नो": 9, "नौ": 9, "nine": 9,
    "das": 10, "दस": 10, "ten": 10,
    "gyarah": 11, "ग्यारह": 11, "eleven": 11,
    "barah": 12, "बारह": 12, "twelve": 12,
    "terah": 13, "तेरह": 13, "thirteen": 13,
    "chaudah": 14, "चौदह": 14, "fourteen": 14,
    "pandrah": 15, "पंद्रह": 15, "fifteen": 15,
    "solah": 16, "सोलह": 16, "sixteen": 16,
    "satrah": 17, "सत्रह": 17, "seventeen": 17,
    "atharah": 18, "अठारह": 18, "eighteen": 18,
    "unnees": 19, "उन्नीस": 19, "nineteen": 19,
    "bees": 20, "बीस": 20, "twenty": 20,
    "pachees": 25, "pachchees": 25, "pachis": 25, "पच्चीस": 25,
    "tees": 30, "तीस": 30, "thirty": 30,
    "chalees": 40, "चालीस": 40, "forty": 40,
    "pachaas": 50, "पचास": 50, "fifty": 50,
}

FRACTIONS = {
    "sawa": 1.25, "sava": 1.25, "सवा": 1.25,
    "dedh": 1.5, "डेढ़": 1.5, "डेढ": 1.5,
    "dhai": 2.5, "dhayi": 2.5, "adhai": 2.5, "ढाई": 2.5,
}

SCALES = {
    "sau": 100, "so": 100, "सौ": 100, "hundred": 100,
    "hazaar": 1000, "hazar": 1000, "hazar": 1000, "हजार": 1000,
    "thousand": 1000,
    "lakh": 100000, "lac": 100000, "लाख": 100000,
    "crore": 10000000, "करोड़": 10000000, "करोड": 10000000,
}

WEEKDAYS = {
    "somvaar": 0, "somvar": 0, "monday": 0, "सोमवार": 0,
    "mangalvaar": 1, "tuesday": 1, "मंगलवार": 1,
    "budhvaar": 2, "wednesday": 2, "बुधवार": 2,
    "guruvaar": 3, "thursday": 3, "गुरुवार": 3,
    "shukravaar": 4, "friday": 4, "शुक्रवार": 4,
    "shanivaar": 5, "saturday": 5, "शनिवार": 5,
    "ravivaar": 6, "sunday": 6, "रविवार": 6,
}


def _fold(text: str) -> str:
    text = text.lower().replace("hazār", "hazaar").replace("हज़ार", "हजार")
    text = re.sub(r"[,₹]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def parse_amount_inr(text: str) -> tuple[float | None, str]:
    """Return (amount, note). None if we cannot parse a single amount."""
    raw = _fold(text)
    # Digits already present (ITN or typed).
    digit = re.search(r"(\d{1,3}(?:,\d{2,3})+|\d+)(?:\.(\d+))?", raw)
    spoken_scale = any(k in raw for k in FRACTIONS) or any(
        k in raw for k in ("hazaar", "hazar", "हजार", "lakh", "lac", "लाख", "crore", "sau", "सौ")
    )

    total = 0.0
    matched = False
    for name, value in FRACTIONS.items():
        if re.search(rf"\b{name}\b", raw):
            scale = 1
            for sname, sval in SCALES.items():
                if re.search(rf"\b{sname}\b", raw):
                    scale = max(scale, sval)
            total = value * scale
            matched = True
            break
    if not matched:
        tokens = re.findall(r"[a-zA-Z\u0900-\u097F]+|\d+", raw)
        acc = 0.0
        i = 0
        while i < len(tokens):
            tok = tokens[i]
            if tok.isdigit():
                acc += float(tok)
                matched = True
            elif tok in ONES:
                acc += ONES[tok]
                matched = True
            elif tok in SCALES:
                if acc == 0:
                    acc = 1
                acc *= SCALES[tok]
                total += acc
                acc = 0
                matched = True
            i += 1
        total += acc

    if not matched and not digit:
        return None, "no_amount_found"
    if digit and not spoken_scale:
        whole = digit.group(0).replace(",", "")
        try:
            return float(whole), "digit_span"
        except ValueError:
            return None, "bad_digit_span"
    if matched:
        return float(total), "spoken_form"
    return None, "unparsed"


def parse_relative_date(text: str, today: date | None = None) -> tuple[date | None, str]:
    today = today or date.today()
    raw = _fold(text)
    if re.search(r"\bparso\b|\bपरसों\b|\bपरसो\b", raw):
        return today + timedelta(days=2), "parso"
    if re.search(r"\baaj\b|\bआज\b|\btoday\b", raw):
        return today, "aaj"
    if re.search(r"\bkal\b|\bकल\b", raw):
        # Kal is ambiguous (yesterday or tomorrow). Force confirmation.
        return today + timedelta(days=1), "kal_ambiguous"
    m = re.search(r"\b(agle|agla|next|अगले|अगला)\s+([a-z\u0900-\u097F]+)", raw)
    if m:
        day = WEEKDAYS.get(m.group(2))
        if day is not None:
            delta = (day - today.weekday()) % 7
            if delta == 0:
                delta = 7
            return today + timedelta(days=delta), "next_weekday"
    # ISO or numeric date
    m = re.search(r"\b(\d{1,2})[/-](\d{1,2})(?:[/-](\d{2,4}))?\b", raw)
    if m:
        dd, mm, yy = int(m.group(1)), int(m.group(2)), m.group(3)
        year = int(yy) if yy else today.year
        if year < 100:
            year += 2000
        try:
            return date(year, mm, dd), "numeric_date"
        except ValueError:
            return None, "invalid_numeric_date"
    return None, "no_date_found"


def parse_mode(text: str) -> tuple[str | None, str]:
    raw = _fold(text)
    if re.search(r"\bupi\b|\byu.?p.?i\b|\byupi\b", raw):
        return "UPI", "upi"
    if re.search(r"\bcash\b|\bnagad\b|\bनकद\b", raw):
        return "CASH", "cash"
    if re.search(r"\bneft\b|\bimps\b|\brtgs\b|\bbank\b|\btransfer\b", raw):
        return "BANK", "bank"
    return None, "no_mode_found"
### slots.py
"""Extract PTP slots from a transcript using the normalizer.

An optional LLM hook can be added later; the default path is deterministic
so the demo still works without a second API key.
"""

from __future__ import annotations

from dataclasses import asdict, dataclass
from datetime import date

from normalizer import parse_amount_inr, parse_mode, parse_relative_date


CRITICAL_SLOTS = ("amount_inr", "pay_date", "mode", "name", "phone")


@dataclass
class SlotFill:
    amount_inr: float | None = None
    amount_note: str = ""
    pay_date: str | None = None
    date_note: str = ""
    mode: str | None = None
    mode_note: str = ""
    name: str | None = None
    phone: str | None = None

    def as_dict(self) -> dict:
        return asdict(self)


def extract_slots(transcript: str, today: date | None = None) -> SlotFill:
    amount, amount_note = parse_amount_inr(transcript)
    when, date_note = parse_relative_date(transcript, today=today)
    mode, mode_note = parse_mode(transcript)
    phone = None
    m = __import__("re").search(r"\b(\d{10})\b", transcript)
    if m:
        phone = m.group(1)
    return SlotFill(
        amount_inr=amount,
        amount_note=amount_note,
        pay_date=when.isoformat() if when else None,
        date_note=date_note,
        mode=mode,
        mode_note=mode_note,
        phone=phone,
    )
### verifier.py
"""Decide whether a critical slot can be trusted.

Prisma REST and streaming responses do not include a usable ASR confidence
score. Official batch samples include a `confidence` field that is `null`.
There is no documented n-best list.

This module therefore never "reads" model confidence. It invents a
trust decision from:
  1. Can the Indic normalizer parse a single unambiguous value?
  2. Do format=transcribe and format=verbatim agree after normalisation?
  3. Is the value plausible (positive amount, date not in the past, known mode)?
  4. If still untrusted, ask for a targeted Timbre read-back.

When dual-pass is skipped (single REST call for latency), every critical
slot that we are about to write is confirmed by read-back. That is the
honest fallback.
"""

from __future__ import annotations

from datetime import date
from typing import Any

from normalizer import parse_amount_inr, parse_mode, parse_relative_date
from slots import CRITICAL_SLOTS, SlotFill, extract_slots


def _amounts_agree(a: float | None, b: float | None) -> bool:
    if a is None or b is None:
        return False
    return abs(a - b) < 0.01


def assess(
    transcribe_text: str,
    verbatim_text: str | None = None,
    today: date | None = None,
    require_confirm_always: bool = True,
) -> dict[str, Any]:
    primary = extract_slots(transcribe_text, today=today)
    secondary = extract_slots(verbatim_text, today=today) if verbatim_text else None

    decisions: dict[str, Any] = {}
    # Amount
    amount_ok = primary.amount_inr is not None and primary.amount_inr > 0
    if secondary:
        amount_ok = amount_ok and _amounts_agree(primary.amount_inr, secondary.amount_inr)
    if primary.amount_note == "kal_ambiguous":
        amount_ok = amount_ok  # unused
    decisions["amount_inr"] = {
        "value": primary.amount_inr,
        "trusted": bool(amount_ok) and not require_confirm_always,
        "needs_confirm": require_confirm_always or not amount_ok,
        "reason": _reason(amount_ok, primary.amount_note, secondary.amount_note if secondary else None),
    }
    # Date
    date_ok = primary.pay_date is not None and primary.date_note != "kal_ambiguous"
    if secondary and secondary.pay_date:
        date_ok = date_ok and primary.pay_date == secondary.pay_date
    if primary.date_note == "kal_ambiguous":
        date_ok = False
    decisions["pay_date"] = {
        "value": primary.pay_date,
        "trusted": bool(date_ok) and not require_confirm_always,
        "needs_confirm": require_confirm_always or not date_ok,
        "reason": _reason(date_ok, primary.date_note, secondary.date_note if secondary else None),
    }
    # Mode
    mode_ok = primary.mode is not None
    if secondary and secondary.mode:
        mode_ok = mode_ok and primary.mode == secondary.mode
    decisions["mode"] = {
        "value": primary.mode,
        "trusted": bool(mode_ok) and not require_confirm_always,
        "needs_confirm": require_confirm_always or not mode_ok,
        "reason": _reason(mode_ok, primary.mode_note, secondary.mode_note if secondary else None),
    }

    pending = [name for name, d in decisions.items() if d["needs_confirm"] and d["value"] is not None]
    missing = [name for name, d in decisions.items() if d["value"] is None]
    return {
        "slots": primary.as_dict(),
        "decisions": decisions,
        "pending_confirm": pending,
        "missing": missing,
        "policy": (
            "confirm_every_critical_slot"
            if require_confirm_always
            else "confirm_when_dual_pass_disagrees_or_implausible"
        ),
        "note": (
            "Prisma does not expose usable ASR confidence or n-best. "
            "Trust here is dual-pass agreement plus normalizer plausibility."
        ),
        "critical_slots": list(CRITICAL_SLOTS),
    }


def _reason(ok: bool, note: str, other: str | None) -> str:
    if other and other != note:
        return f"{note}; dual_pass_other={other}; agree={ok}"
    return note if ok else f"untrusted:{note}"


def readback_prompt(decisions: dict[str, Any]) -> str:
    parts = []
    amount = decisions.get("amount_inr", {}).get("value")
    when = decisions.get("pay_date", {}).get("value")
    mode = decisions.get("mode", {}).get("value")
    if amount is not None:
        parts.append(f"{int(amount)} rupaye")
    if when:
        parts.append(f"tareekh {when}")
    if mode:
        parts.append(f"mode {mode}")
    if not parts:
        return "Main samajh nahi paayi. Kitne rupaye, kab, aur kaise bharenge? Ek baar clearly boliye."
    joined = ", ".join(parts)
    return f"Confirm karne ke liye boliye haan. Maine note kiya: {joined}. Galat ho to sahi figures boliye."
### state_machine.py
"""PTP conversation state machine.

States:
  GREETING -> COLLECTING -> CONFIRMING -> WRITTEN
                                    -> CLARIFY -> COLLECTING
  any -> HANDOFF
  any -> REFUSED
"""

from __future__ import annotations

from enum import Enum


class State(str, Enum):
    GREETING = "GREETING"
    COLLECTING = "COLLECTING"
    CONFIRMING = "CONFIRMING"
    CLARIFY = "CLARIFY"
    WRITTEN = "WRITTEN"
    HANDOFF = "HANDOFF"
    REFUSED = "REFUSED"


TRANSITIONS = {
    State.GREETING: {State.COLLECTING, State.HANDOFF, State.REFUSED},
    State.COLLECTING: {State.CONFIRMING, State.CLARIFY, State.COLLECTING, State.WRITTEN, State.HANDOFF, State.REFUSED},
    State.CONFIRMING: {State.WRITTEN, State.CLARIFY, State.COLLECTING, State.HANDOFF, State.REFUSED},
    State.CLARIFY: {State.COLLECTING, State.CONFIRMING, State.HANDOFF, State.REFUSED},
    State.WRITTEN: set(),
    State.HANDOFF: set(),
    State.REFUSED: set(),
}


def can_move(current: State, nxt: State) -> bool:
    return nxt in TRANSITIONS[current]
### idempotency.py
"""Idempotent PTP commits. A retry cannot insert a second row."""

from __future__ import annotations

import hashlib
import json
from datetime import datetime, timezone
from typing import Any


def commit_key(session_id: str, amount_inr: float, pay_date: str, mode: str) -> str:
    canonical = json.dumps(
        {
            "session_id": session_id,
            "amount_inr": round(float(amount_inr), 2),
            "pay_date": pay_date,
            "mode": mode,
        },
        sort_keys=True,
    )
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


class Ledger:
    def __init__(self) -> None:
        self.rows: list[dict[str, Any]] = []
        self.keys: set[str] = set()

    def commit(self, session_id: str, amount_inr: float, pay_date: str, mode: str) -> dict[str, Any]:
        key = commit_key(session_id, amount_inr, pay_date, mode)
        if key in self.keys:
            existing = next(r for r in self.rows if r["commit_key"] == key)
            return {"written": False, "duplicate": True, "row": existing}
        row = {
            "commit_key": key,
            "session_id": session_id,
            "amount_inr": round(float(amount_inr), 2),
            "pay_date": pay_date,
            "mode": mode,
            "written_at": datetime.now(timezone.utc).isoformat(),
        }
        self.keys.add(key)
        self.rows.append(row)
        return {"written": True, "duplicate": False, "row": row}
### handoff.py
"""Detect a request for a human, or distress, and build a one-line brief.

This is application-level barge-in / handoff detection. Prisma streaming can
emit a speech_start event when voice is detected; stopping Timbre playback is
the app's job, not a Gnani API.
"""

from __future__ import annotations

import re

HANDOFF_PATTERNS = [
    r"insaan",
    r"insan",
    r"human",
    r"agent se baat",
    r"operator",
    r"supervisor",
    r"kisi se baat",
    r"मुझे किसी इंसान",
    r"इंसान से बात",
    r"complaint",
    r"shikayat",
    r"शिकायत",
]

DISTRESS_PATTERNS = [
    r"ghabra",
    r"dard",
    r"police",
    r"arrest",
    r"threat",
    r"डरा",
]


def detect_handoff(transcript: str) -> dict:
    raw = transcript.lower()
    for pat in HANDOFF_PATTERNS:
        if re.search(pat, raw, flags=re.IGNORECASE):
            return {"handoff": True, "reason": "human_requested", "pattern": pat}
    for pat in DISTRESS_PATTERNS:
        if re.search(pat, raw, flags=re.IGNORECASE):
            return {"handoff": True, "reason": "distress", "pattern": pat}
    return {"handoff": False, "reason": None, "pattern": None}


def brief(slots: dict, transcript: str, reason: str) -> str:
    amount = slots.get("amount_inr")
    when = slots.get("pay_date")
    mode = slots.get("mode")
    return (
        f"Handoff ({reason}). Last line: {transcript!r}. "
        f"Slots so far: amount={amount}, date={when}, mode={mode}."
    )
