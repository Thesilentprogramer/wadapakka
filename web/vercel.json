{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://wadapakka.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://wadapakka.onrender.com/health" },
    { "source": "/static/:path*", "destination": "https://wadapakka.onrender.com/static/:path*" }
  ]
}
